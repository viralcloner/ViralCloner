{
  "name": "viralcloner",
  "version": "1.8.5",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Shibreg",
  "license": "ISC",
  "description": "ViralCloner is a desktop tool to clone and customize viral content.",
  "devDependencies": {
    "@electron/asar": "^4.0.1",
    "@pilio/gemini-watermark-remover": "^1.0.10",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "png-to-ico": "^3.0.1",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "com.shibreg.viralcloner",
    "productName": "ViralCloner",
    "beforePack": "./scripts/beforePack.js",
    "afterPack": "./scripts/afterPack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "automations/**",
      "data/**",
      "frontend/**",
      "plugins/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!**/*.zip",
      "!frontend/subWindows/login/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/canvas/**",
      "node_modules/sharp/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "frontend/assets/images/app-icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "artifactName": "ViralCloner-Setup-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "viralcloner",
      "repo": "Windows-ViralCloner",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/lib-storage": "^3.940.0",
    "archiver": "^7.0.1",
    "axios": "^1.11.0",
    "better-sqlite3": "^12.2.0",
    "canvas": "^3.2.3",
    "chrome-remote-interface": "^0.33.3",
    "dotenv": "^17.2.1",
    "edge-tts-universal": "^1.4.0",
    "exiftool-vendored": "^35.13.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.1.1",
    "gemini-watermark-remover": "github:GargantuaX/gemini-watermark-remover",
    "html2canvas": "^1.4.1",
    "https-proxy-agent": "^7.0.6",
    "imagekit": "^6.0.0",
    "imapflow": "^1.4.2",
    "js-sha3": "^0.9.3",
    "js-tiktoken": "^1.0.21",
    "mailparser": "^3.9.11",
    "node-fetch": "^2.7.0",
    "node-machine-id": "^1.1.12",
    "node-telegram-bot-api": "^0.66.0",
    "otpauth": "^9.5.0",
    "piexifjs": "^1.0.6",
    "puppeteer": "^24.15.0",
    "rcedit": "^4.0.1",
    "removebanana": "^1.0.1",
    "roboto-fontface": "^0.10.0",
    "serpapi": "^2.2.1",
    "sharp": "^0.34.5",
    "ssim.js": "^3.5.0",
    "tippy.js": "^6.3.7",
    "ws": "^8.18.3",
    "form-data": "^4.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viralcloner/Windows-ViralCloner.git"
  },
  "homepage": "https://github.com/viralcloner/Windows-ViralCloner",
  "bugs": {
    "url": "https://github.com/viralcloner/Windows-ViralCloner/issues"
  }
}
