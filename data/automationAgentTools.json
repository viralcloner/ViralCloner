{
  "version": "1.0",
  "description": "Tool definitions for AI automation agent",
  "tools": [
    {
      "name": "add_node",
      "description": "Add a new processing node to the canvas (Step 2 of workflow building). Returns the node's exact 'ports' map: {inputs:[{id,type,label}...], outputs:[...]}. Read these port IDs before calling connect_nodes.",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeType": {
            "type": "string",
            "description": "Node type",
            "enum": [
              "openai",
              "openrouter",
              "googleai",
              "anthropic",
              "chineseai",
              "chatgptchat",
              "midjourney",
              "chatgptimage",
              "gptimage",
              "googleaiimage",
              "geminiimage",
              "metaaiimage",
              "metaaivideo",
              "googledocsveo",
              "soraimage",
              "minicanvas",
              "imageupload",
              "videoupload",
              "imagedownloader",
              "videotoimage",
              "googlesites",
              "wordpress",
              "wordpressget",
              "wprecipemaker",
              "variables",
              "jsonparser",
              "splitter",
              "curl",
              "advancedcurl",
              "serpapi",
              "amazoncrawl",
              "amazonafflink",
              "vctts",
              "videoeditor",
              "deepseekbrowser",
              "qwenbrowser",
              "subautomation"
            ]
          },
          "label": {
            "type": "string",
            "description": "Display label"
          },
          "configValues": {
            "type": "object",
            "description": "Config: prompt (for AI/image nodes), text (for variables node template), model, deepThink, webSearch",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "temperature": {
                "type": "number"
              },
              "model": {
                "type": "string"
              },
              "maxTokens": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "splitSymbol": {
                "type": "string"
              },
              "deepThink": {
                "type": "string",
                "description": "'true' or 'false', deepseekbrowser only"
              },
              "webSearch": {
                "type": "string",
                "description": "'true' or 'false', deepseekbrowser/qwenbrowser only"
              }
            }
          },
          "positionHint": {
            "type": "string",
            "default": "auto"
          }
        },
        "required": [
          "nodeType"
        ]
      }
    },
    {
      "name": "edit_node",
      "description": "Edit node config (prompt, model, etc). Get nodeId from get_canvas_state first.",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "Node ID to edit"
          },
          "label": {
            "type": "string"
          },
          "configValues": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "temperature": {
                "type": "number"
              },
              "model": {
                "type": "string"
              },
              "maxTokens": {
                "type": "string"
              },
              "template": {
                "type": "string"
              },
              "website": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "fieldPath": {
                "type": "string"
              },
              "splitSymbol": {
                "type": "string"
              },
              "trackingId": {
                "type": "string"
              },
              "size": {
                "type": "string"
              },
              "quality": {
                "type": "string"
              },
              "variants": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "nodeId"
        ]
      }
    },
    {
      "name": "delete_node",
      "description": "Delete node and its connections",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          }
        },
        "required": [
          "nodeId"
        ]
      }
    },
    {
      "name": "connect_nodes",
      "description": "Connect two nodes. Only use when user asks to connect nodes or when building a new workflow. Check node signatures first to avoid type mismatches!",
      "parameters": {
        "type": "object",
        "properties": {
          "fromNodeId": {
            "type": "string"
          },
          "fromOutput": {
            "type": "string",
            "description": "e.g. output_1"
          },
          "toNodeId": {
            "type": "string"
          },
          "toInput": {
            "type": "string",
            "description": "e.g. input_1, input_2"
          }
        },
        "required": [
          "fromNodeId",
          "fromOutput",
          "toNodeId",
          "toInput"
        ]
      }
    },
    {
      "name": "disconnect_nodes",
      "description": "Remove connection between nodes",
      "parameters": {
        "type": "object",
        "properties": {
          "fromNodeId": {
            "type": "string"
          },
          "fromOutput": {
            "type": "string"
          },
          "toNodeId": {
            "type": "string"
          },
          "toInput": {
            "type": "string"
          }
        },
        "required": [
          "fromNodeId",
          "fromOutput",
          "toNodeId",
          "toInput"
        ]
      }
    },
    {
      "name": "get_node_info",
      "description": "Returns exact port spec for any node type before you add it. Call this BEFORE planning if you are unsure about a node's inputs/outputs. Returns ports with exact IDs, types, and labels.",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeType": {
            "type": "string",
            "description": "The node type to look up (e.g. 'wordpress', 'deepseekbrowser', 'midjourney', 'variables')"
          }
        },
        "required": [
          "nodeType"
        ]
      }
    },
    {
      "name": "get_canvas_state",
      "description": "Get current canvas nodes and connections. Call first!",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "get_node_details",
      "description": "Get node config values",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          }
        },
        "required": [
          "nodeId"
        ]
      }
    },
    {
      "name": "clear_canvas",
      "description": "Clear all nodes except input. Use with caution!",
      "parameters": {
        "type": "object",
        "properties": {
          "keepInputNode": {
            "type": "boolean",
            "default": true
          }
        },
        "required": []
      }
    },
    {
      "name": "auto_layout",
      "description": "Auto-arrange nodes left-to-right. Only use when user explicitly asks to 'arrange', 'layout', or 'organize' the canvas. Never use automatically!",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  ],
